AI_HR_ASR_TENCENT_WS_ALLOW_HTTP_FALLBACK=false
AI_HR_ASR_TENCENT_WS_EXPIRE_SECONDS=90
AI_HR_ASR_TENCENT_WS_SESSION_TTL_SECONDS=45
AI_HR_ASR_TENCENT_WS_PARTIAL_WAIT_MS=35
AI_HR_ASR_TENCENT_WS_FINAL_WAIT_MS=800
