# ============================================================
# AI-HR Development Environment
# 文件用途：
# 1. 本地 Windows/WSL 联调 AI-HR 后端
# 2. 前端通过后端创建 session，并接入 Agora + TEN
# 3. TEN Python Host 在 WSL/Linux 中运行
# ============================================================

# ------------------------------------------------------------
# 基础运行环境
# ------------------------------------------------------------
AI_HR_ENV=dev
AI_HR_APP_NAME=AI-HR API (DEV)
AI_HR_APP_VERSION=0.1.0
AI_HR_API_PREFIX=/api/v1
AI_HR_ENVIRONMENT=dev
AI_HR_DEBUG=true
AI_HR_AUTO_CREATE_TABLES=true
AI_HR_HOST=127.0.0.1
AI_HR_PORT=8000
AI_HR_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AI_HR_CORS_ALLOW_CREDENTIALS=false

# ------------------------------------------------------------
# 数据库
# 必填：后端启动必须可连接数据库
# ------------------------------------------------------------
AI_HR_DATABASE_URL=mysql+pymysql://root:123456789@127.0.0.1:3306/ai_hr

# ------------------------------------------------------------
# BOSS 直聘相关
# 本地联调可以继续用 mock；如果当前不调这部分，下面配置先不用动
# ------------------------------------------------------------
AI_HR_BOSS_MODE=mock
AI_HR_BOSS_ACCOUNT=demo-account
AI_HR_BOSS_SECRET=demo-secret
AI_HR_BOSS_BASE_URL=https://www.zhipin.com
AI_HR_BOSS_PUBLISH_PATH=/wapi/zpjob/job/publish.json
AI_HR_BOSS_STATUS_PATH=/wapi/zpjob/job/status.json
AI_HR_BOSS_APPLICANTS_PATH=/wapi/zpjob/job/applicants.json
AI_HR_BOSS_GREET_PATH=/wapi/zpchat/greet/send.json
AI_HR_BOSS_FETCH_MESSAGES_PATH=/wapi/zpchat/conversation/messages.json
AI_HR_BOSS_SEND_MESSAGE_PATH=/wapi/zpchat/conversation/send.json
AI_HR_BOSS_INTERVIEW_SCHEDULE_PATH=/wapi/zpinterview/interview/schedule.json
AI_HR_BOSS_INTERVIEW_STATUS_PATH=/wapi/zpinterview/interview/status.json
AI_HR_BOSS_COOKIE_HEADER=
AI_HR_BOSS_CREDENTIAL_FILE=
AI_HR_BOSS_TIMEOUT_SECONDS=20

# ------------------------------------------------------------
# RTC 总开关
# 现在前端和 TEN 主链路都走 Agora，所以这里必须是 agora
# ------------------------------------------------------------
AI_HR_RTC_PROVIDER=agora
AI_HR_RTC_DEFAULT_TRANSPORT=webrtc
AI_HR_RTC_TOKEN_TTL_SECONDS=3600

# ------------------------------------------------------------
# Agora RTC
# 必填：
# - AI_HR_AGORA_APP_ID
# - AI_HR_AGORA_APP_CERTIFICATE
# 说明：
# - 后端 create_session / rtc_join 会基于这里签发 token
# - TEN 侧 room/token/app_id 也从这里衍生
# ------------------------------------------------------------
AI_HR_AGORA_APP_ID=72f8343592b64607a2e0c7b995c637c2
AI_HR_AGORA_APP_CERTIFICATE=ec7f70298bc7479da3326d5ece61e10b
AI_HR_AGORA_ROOM_PREFIX=ai-intv-
AI_HR_AGORA_TOKEN_TTL_SECONDS=3600
AI_HR_AGORA_TEN_BOT_USER_ID_PREFIX=aihr-bot-

# ------------------------------------------------------------
# LiveKit 旧链路配置
# 现在主链路已不依赖 LiveKit，可保留但默认不会使用
# ------------------------------------------------------------
AI_HR_LIVEKIT_BASE_URL=https://ai-hr-g6ha4xe4.livekit.cloud
AI_HR_LIVEKIT_API_KEY=API7d79ZqDSYEfF
AI_HR_LIVEKIT_API_SECRET=tm1toFOZQvqF1kyddErAHGFTDr1kD3M1Y6HunQ41rIM
AI_HR_LIVEKIT_CREATE_ROOM_PATH=/twirp/livekit.RoomService/CreateRoom
AI_HR_LIVEKIT_UPDATE_SUBSCRIPTIONS_PATH=/twirp/livekit.RoomService/UpdateSubscriptions
AI_HR_LIVEKIT_SEND_DATA_PATH=/twirp/livekit.RoomService/SendData
AI_HR_LIVEKIT_ROOM_PREFIX=ai-intv-
AI_HR_LIVEKIT_WEBHOOK_SIGNATURE_REQUIRED=true
AI_HR_LIVEKIT_WEBHOOK_API_KEY=
AI_HR_LIVEKIT_WEBHOOK_ACCEPT_SKEW_SECONDS=120

# ------------------------------------------------------------
# AI Interview RTC 附加能力
# 当前 Agora/TEN 方案下，前端主链路先不依赖这些开关
# 保留是为了兼容已有能力
# ------------------------------------------------------------
AI_HR_AI_INTERVIEW_RTC_WEBHOOK_ENABLED=false
AI_HR_AI_INTERVIEW_RTC_AUDIO_SUBSCRIBE_ENABLED=true
AI_HR_AI_INTERVIEW_RTC_AUDIO_SUBSCRIBE_AUTO=true
AI_HR_AI_INTERVIEW_RTC_AUDIO_TRACK_IDS=
AI_HR_AI_INTERVIEW_RTC_AUDIO_SUBSCRIBER_IDENTITY=ai-bot
AI_HR_AI_INTERVIEW_RTC_TTS_PUBLISH_ENABLED=true
AI_HR_AI_INTERVIEW_RTC_TTS_BOT_IDENTITY=ai-bot
AI_HR_AI_INTERVIEW_RTC_VIDEO_POLICY_ENABLED=false
AI_HR_AI_INTERVIEW_RTC_VIDEO_SUBSCRIBE_AUTO=true
AI_HR_AI_INTERVIEW_RTC_VIDEO_RECORD_ENABLED=false
AI_HR_AI_INTERVIEW_RTC_VIDEO_TRACK_IDS=
AI_HR_AI_INTERVIEW_RTC_VIDEO_SUBSCRIBER_IDENTITY=ai-bot
AI_HR_AI_INTERVIEW_RTC_DUPLEX_WS_ENABLED=true
AI_HR_AI_INTERVIEW_RTC_ASR_INGEST_WS_ENABLED=true

# ------------------------------------------------------------
# TEN Runtime
# 必填：
# - AI_HR_AI_INTERVIEW_TEN_ENABLED=true
# - AI_HR_AI_INTERVIEW_TEN_AGENT_DIR
# - AI_HR_AI_INTERVIEW_TEN_TMAN_CMD
# - AI_HR_AI_INTERVIEW_TEN_PYTHON_LIB_PATH
#
# 说明：
# - Windows 开发时，TEN 实际建议在 WSL 内运行
# - AI_HR_AI_INTERVIEW_TEN_AGENT_DIR 应该填写 WSL/Linux 可识别的路径
# - AI_HR_AI_INTERVIEW_TEN_PYTHON_LIB_PATH 要指向 libpython3.x.so
# ------------------------------------------------------------
AI_HR_AI_INTERVIEW_TEN_ENABLED=true
AI_HR_AI_INTERVIEW_TEN_AUTO_LAUNCH=false
AI_HR_AI_INTERVIEW_TEN_AGENT_DIR=D:/24985/code/boss-cli-main/AI-HR/ten_agent
AI_HR_AI_INTERVIEW_TEN_TMAN_CMD=tman
AI_HR_AI_INTERVIEW_TEN_SESSION_DIR=D:/24985/code/boss-cli-main/AI-HR/ten_agent/.ten_sessions
AI_HR_AI_INTERVIEW_TEN_PROPERTY_TEMPLATE=D:/24985/code/boss-cli-main/AI-HR/ten_agent/property.json
AI_HR_AI_INTERVIEW_TEN_PYTHON_LIB_PATH=/usr/lib/x86_64-linux-gnu/libpython3.10.so

# ------------------------------------------------------------
# Duplex / Realtime 行为
# 这些主要影响全双工实时链路的缓冲和触发策略
# 一般先用默认值，除非做延时调优
# ------------------------------------------------------------
AI_HR_AI_INTERVIEW_DUPLEX_SEEN_FRAME_WINDOW=2048
AI_HR_AI_INTERVIEW_DUPLEX_MAX_INFLIGHT_CHUNKS=6
AI_HR_AI_INTERVIEW_DUPLEX_STATS_EMIT_EVERY=20
AI_HR_AI_INTERVIEW_DUPLEX_PARTIAL_TRIGGER_ENABLED=true
AI_HR_AI_INTERVIEW_DUPLEX_PARTIAL_MIN_CHARS=8
AI_HR_AI_INTERVIEW_DUPLEX_PARTIAL_DEDUP_TTL_MS=1500

# ------------------------------------------------------------
# ASR Provider
# 当前 ten_agent 里使用腾讯 ASR 扩展，但项目里也保留了阿里云能力
# 建议：
# - 如果 TEN 扩展走腾讯 ASR，就把腾讯云相关配置填完整
# - 如果后端其他链路还在用阿里云，也把阿里云保留
# ------------------------------------------------------------
AI_HR_ASR_PROVIDER=aliyun_nls
AI_HR_ASR_FORCE_STREAMING=true
AI_HR_ASR_API_KEY=
AI_HR_ASR_BASE_URL=
AI_HR_ASR_STREAM_TIMEOUT_MS=5000
AI_HR_ASR_HOTWORD_FILE=technical_hot_words.txt

# 阿里云 ASR / NLS
AI_HR_ASR_ALIYUN_API_KEY=sk-5b5ab67ac63c44f4a02e9e55f23688f4
AI_HR_ASR_ALIYUN_MODEL=paraformer-realtime-v1
AI_HR_ASR_ALIYUN_STREAMING_ENABLED=true
AI_HR_ASR_ALIYUN_APPKEY=qkufZ4MjY4ev9JQb
AI_HR_ALIYUN_ACCESS_KEY_ID=LTAI5tEivqMhxmuZfTHoGvjt
AI_HR_ALIYUN_ACCESS_KEY_SECRET=3mfMYWLm4uTq8HYZGMiUrqtZ7HAumc

# 腾讯云 ASR
# 必填场景：ten_agent/tencent_asr_python 要成功启动时
AI_HR_TENCENT_SECRET_ID=AKIDLaeQ0OdglpiPuCJTRFoCPQHzT0OeibHl
AI_HR_TENCENT_SECRET_KEY=g9RWP6blmutjNQI0b0DF7xyyoWDqMiy3
