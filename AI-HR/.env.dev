# ------------------------------------------------------------
# TTS Provider
# 当前 ten_agent 里使用腾讯 TTS 扩展
# 必填场景：AI 回答要通过 TEN 回灌到 Agora 时
# ------------------------------------------------------------
AI_HR_TTS_PROVIDER=tencent
AI_HR_TTS_FORCE_STREAMING=true
AI_HR_TTS_API_KEY=
AI_HR_TTS_BASE_URL=
AI_HR_TTS_STREAM_TIMEOUT_MS=5000

