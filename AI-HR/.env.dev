AI_HR_TTS_TENCENT_APP_ID=1413662430
AI_HR_TTS_TENCENT_VOICE_TYPE=101001
AI_HR_TTS_TENCENT_SAMPLE_RATE=16000
AI_HR_TTS_TENCENT_CODEC=pcm
AI_HR_TTS_TENCENT_WS_BASE_URL=wss://tts.cloud.tencent.com/stream_wsv2
AI_HR_TTS_TENCENT_WS_STREAMING_ENABLED=true
AI_HR_TTS_TENCENT_WS_ALLOW_HTTP_FALLBACK=false
AI_HR_TTS_TENCENT_WS_EXPIRE_SECONDS=90
AI_HR_TTS_TENCENT_WS_OPEN_TIMEOUT_MS=1200
AI_HR_TTS_TENCENT_WS_RECV_TIMEOUT_MS=1200
AI_HR_TTS_FIRST_CHUNK_SIZE=12
AI_HR_TTS_WARMUP_ENABLED=true

# ------------------------------------------------------------
# LLM
# 必填场景：面试追问、总结、生成 follow-up
# ------------------------------------------------------------
AI_HR_LLM_PROVIDER=openai
AI_HR_LLM_MODEL=gpt-4o-mini
AI_HR_LLM_BASE_URL=https://www.huggingclaw.store
AI_HR_LLM_API_KEY=sk-d205f110239b2a7fbcb686dd9d8763d53c2f278cb3cac3517b32103f52e215fb
