# ============================================================
# AI-HR Production Environment Template
# 这是生产模板文件，请务必替换所有占位值，不要直接带示例值上线
# ============================================================

# ------------------------------------------------------------
# 基础运行环境
# ------------------------------------------------------------
AI_HR_ENV=prod
AI_HR_APP_NAME=AI-HR API
AI_HR_APP_VERSION=0.1.0
AI_HR_API_PREFIX=/api/v1
AI_HR_ENVIRONMENT=prod
AI_HR_DEBUG=false
AI_HR_AUTO_CREATE_TABLES=false
AI_HR_HOST=0.0.0.0
AI_HR_PORT=8000
AI_HR_CORS_ALLOW_ORIGINS=https://hr.example.com,https://admin.example.com
AI_HR_CORS_ALLOW_CREDENTIALS=true

# ------------------------------------------------------------
# 数据库
# 必填
# ------------------------------------------------------------
AI_HR_DATABASE_URL=mysql+pymysql://username:password@mysql-prod:3306/ai_hr

# ------------------------------------------------------------
# 鉴权
# 建议生产环境打开
# ------------------------------------------------------------
AI_HR_AI_INTERVIEW_AUTH_REQUIRED=true
AI_HR_AI_INTERVIEW_API_KEYS=replace-with-strong-api-key

# ------------------------------------------------------------
# BOSS 直聘
# 如生产要启用真实链路，请填真实账号和凭证
# ------------------------------------------------------------
AI_HR_BOSS_MODE=live
AI_HR_BOSS_ACCOUNT=replace-with-prod-account
AI_HR_BOSS_SECRET=replace-with-prod-secret
AI_HR_BOSS_BASE_URL=https://www.zhipin.com
AI_HR_BOSS_PUBLISH_PATH=/wapi/zpjob/job/publish.json
AI_HR_BOSS_STATUS_PATH=/wapi/zpjob/job/status.json
AI_HR_BOSS_APPLICANTS_PATH=/wapi/zpjob/job/applicants.json
AI_HR_BOSS_GREET_PATH=/wapi/zpchat/greet/send.json
AI_HR_BOSS_FETCH_MESSAGES_PATH=/wapi/zpchat/conversation/messages.json
AI_HR_BOSS_SEND_MESSAGE_PATH=/wapi/zpchat/conversation/send.json
AI_HR_BOSS_INTERVIEW_SCHEDULE_PATH=/wapi/zpinterview/interview/schedule.json
AI_HR_BOSS_INTERVIEW_STATUS_PATH=/wapi/zpinterview/interview/status.json
AI_HR_BOSS_COOKIE_HEADER=
AI_HR_BOSS_CREDENTIAL_FILE=
AI_HR_BOSS_TIMEOUT_SECONDS=20

# ------------------------------------------------------------
# RTC 主链路
# 生产 Agora/TEN 方案必须配 agora
# ------------------------------------------------------------
AI_HR_RTC_PROVIDER=agora
AI_HR_RTC_DEFAULT_TRANSPORT=webrtc
AI_HR_RTC_TOKEN_TTL_SECONDS=3600

# Agora
AI_HR_AGORA_APP_ID=replace-with-agora-app-id
AI_HR_AGORA_APP_CERTIFICATE=replace-with-agora-app-certificate
AI_HR_AGORA_ROOM_PREFIX=ai-intv-
AI_HR_AGORA_TOKEN_TTL_SECONDS=3600
AI_HR_AGORA_TEN_BOT_USER_ID_PREFIX=aihr-bot-

# ------------------------------------------------------------
# TEN Runtime
# 必填：
# - AGENT_DIR: 服务器上的 ten_agent 目录
# - TMAN_CMD: 服务器上可执行的 tman 命令
# - PYTHON_LIB_PATH: Linux 上的 libpython3.x.so
# ------------------------------------------------------------
AI_HR_AI_INTERVIEW_TEN_ENABLED=true
AI_HR_AI_INTERVIEW_TEN_AUTO_LAUNCH=true
AI_HR_AI_INTERVIEW_TEN_AGENT_DIR=/opt/ai-hr/ten_agent
AI_HR_AI_INTERVIEW_TEN_TMAN_CMD=tman
AI_HR_AI_INTERVIEW_TEN_SESSION_DIR=/opt/ai-hr/ten_agent/.ten_sessions
AI_HR_AI_INTERVIEW_TEN_PROPERTY_TEMPLATE=/opt/ai-hr/ten_agent/property.json
AI_HR_AI_INTERVIEW_TEN_PYTHON_LIB_PATH=/usr/lib/x86_64-linux-gnu/libpython3.10.so

# ------------------------------------------------------------
# RTC 补充能力
# ------------------------------------------------------------
AI_HR_AI_INTERVIEW_RTC_WEBHOOK_ENABLED=false
AI_HR_AI_INTERVIEW_RTC_AUDIO_SUBSCRIBE_ENABLED=true
AI_HR_AI_INTERVIEW_RTC_AUDIO_SUBSCRIBE_AUTO=true
AI_HR_AI_INTERVIEW_RTC_AUDIO_TRACK_IDS=
AI_HR_AI_INTERVIEW_RTC_AUDIO_SUBSCRIBER_IDENTITY=ai-bot
AI_HR_AI_INTERVIEW_RTC_TTS_PUBLISH_ENABLED=true
AI_HR_AI_INTERVIEW_RTC_TTS_BOT_IDENTITY=ai-bot
AI_HR_AI_INTERVIEW_RTC_VIDEO_POLICY_ENABLED=false
AI_HR_AI_INTERVIEW_RTC_VIDEO_SUBSCRIBE_AUTO=true
AI_HR_AI_INTERVIEW_RTC_VIDEO_RECORD_ENABLED=false
AI_HR_AI_INTERVIEW_RTC_VIDEO_TRACK_IDS=
AI_HR_AI_INTERVIEW_RTC_VIDEO_SUBSCRIBER_IDENTITY=ai-bot
AI_HR_AI_INTERVIEW_RTC_DUPLEX_WS_ENABLED=true
AI_HR_AI_INTERVIEW_RTC_ASR_INGEST_WS_ENABLED=true

# ------------------------------------------------------------
# Duplex 调优
# ------------------------------------------------------------
AI_HR_AI_INTERVIEW_DUPLEX_SEEN_FRAME_WINDOW=2048
AI_HR_AI_INTERVIEW_DUPLEX_MAX_INFLIGHT_CHUNKS=6
AI_HR_AI_INTERVIEW_DUPLEX_STATS_EMIT_EVERY=20
AI_HR_AI_INTERVIEW_DUPLEX_PARTIAL_TRIGGER_ENABLED=true
AI_HR_AI_INTERVIEW_DUPLEX_PARTIAL_MIN_CHARS=8
AI_HR_AI_INTERVIEW_DUPLEX_PARTIAL_DEDUP_TTL_MS=1500

# ------------------------------------------------------------
# 腾讯云 ASR / TTS
# 生产 TEN 扩展通常需要这组
# ------------------------------------------------------------
AI_HR_TENCENT_SECRET_ID=replace-with-tencent-secret-id
AI_HR_TENCENT_SECRET_KEY=replace-with-tencent-secret-key
AI_HR_TENCENT_REGION=ap-guangzhou

AI_HR_ASR_PROVIDER=tencent
AI_HR_ASR_FORCE_STREAMING=true
AI_HR_ASR_HOTWORD_FILE=technical_hot_words.txt
AI_HR_ASR_TENCENT_APP_ID=replace-with-tencent-asr-app-id
AI_HR_ASR_TENCENT_ENGINE_TYPE=16k_zh
AI_HR_ASR_TENCENT_VOICE_FORMAT=4
AI_HR_ASR_TENCENT_WS_BASE_URL=wss://asr.cloud.tencent.com/asr/v2
AI_HR_ASR_TENCENT_STREAMING_ENABLED=true
AI_HR_ASR_TENCENT_WS_ALLOW_HTTP_FALLBACK=true
AI_HR_ASR_TENCENT_WS_EXPIRE_SECONDS=90
AI_HR_ASR_TENCENT_WS_SESSION_TTL_SECONDS=45
AI_HR_ASR_TENCENT_WS_PARTIAL_WAIT_MS=35
AI_HR_ASR_TENCENT_WS_FINAL_WAIT_MS=800
AI_HR_ASR_TENCENT_WS_OPEN_TIMEOUT_MS=800
AI_HR_ASR_TENCENT_WS_SINGLE_CONNECTION_ENABLED=true
AI_HR_ASR_TENCENT_PREWARM_ENABLED=true
AI_HR_ASR_TENCENT_KEEPALIVE_INTERVAL_SECONDS=8
AI_HR_ASR_TENCENT_KEEPALIVE_PCM_MS=40

AI_HR_TTS_PROVIDER=tencent
AI_HR_TTS_FORCE_STREAMING=true
AI_HR_TTS_TENCENT_APP_ID=replace-with-tencent-tts-app-id
AI_HR_TTS_TENCENT_VOICE_TYPE=101001
AI_HR_TTS_TENCENT_SAMPLE_RATE=16000
AI_HR_TTS_TENCENT_CODEC=pcm
AI_HR_TTS_TENCENT_WS_BASE_URL=wss://tts.cloud.tencent.com/stream_wsv2
AI_HR_TTS_TENCENT_WS_STREAMING_ENABLED=true
AI_HR_TTS_TENCENT_WS_ALLOW_HTTP_FALLBACK=false
AI_HR_TTS_TENCENT_WS_EXPIRE_SECONDS=90
AI_HR_TTS_TENCENT_WS_OPEN_TIMEOUT_MS=1200
AI_HR_TTS_TENCENT_WS_RECV_TIMEOUT_MS=1200
AI_HR_TTS_FIRST_CHUNK_SIZE=12
AI_HR_TTS_WARMUP_ENABLED=true

# ------------------------------------------------------------
# 如果生产还保留阿里云 ASR 备用链路，可额外配置
# ------------------------------------------------------------
AI_HR_ASR_ALIYUN_API_KEY=
AI_HR_ASR_ALIYUN_MODEL=paraformer-realtime-v1
AI_HR_ASR_ALIYUN_STREAMING_ENABLED=true
AI_HR_ASR_ALIYUN_APPKEY=
AI_HR_ALIYUN_ACCESS_KEY_ID=
AI_HR_ALIYUN_ACCESS_KEY_SECRET=

# ------------------------------------------------------------
# LLM
# ------------------------------------------------------------
AI_HR_LLM_PROVIDER=openai
AI_HR_LLM_MODEL=gpt-4.1-mini
AI_HR_LLM_BASE_URL=
AI_HR_LLM_API_KEY=replace-with-llm-api-key
AI_HR_LLM_STREAMING_ENABLED=true
AI_HR_LLM_TIMEOUT_SECONDS=40
AI_HR_LLM_MAX_RETRIES=2
AI_HR_AI_INTERVIEW_LLM_ENABLED=true

# ------------------------------------------------------------
# Redis / Runtime Store
# 建议生产启用
# ------------------------------------------------------------
AI_HR_REDIS_URL=redis://redis-prod:6379/0
AI_HR_AI_INTERVIEW_REDIS_ENABLED=true
AI_HR_AI_INTERVIEW_REDIS_PREFIX=aihr
AI_HR_AI_INTERVIEW_QUESTION_PACK_TTL_SECONDS=172800
AI_HR_AI_INTERVIEW_STATE_TTL_SECONDS=172800
AI_HR_AI_INTERVIEW_DEDUP_TTL_SECONDS=86400
AI_HR_AI_INTERVIEW_FOLLOWUP_CACHE_TTL_SECONDS=180
AI_HR_AI_INTERVIEW_PREBUILD_PACK_TTL_SECONDS=604800
AI_HR_AI_INTERVIEW_REDIS_EVENT_BUS_ENABLED=true

# ------------------------------------------------------------
# 健康检查 / Provider 稳定性
# ------------------------------------------------------------
AI_HR_PROVIDER_HEALTH_PROBE_ENABLED=true
AI_HR_PROVIDER_HEALTH_PROBE_TIMEOUT_MS=1200
AI_HR_PROVIDER_CIRCUIT_BREAKER_FAIL_THRESHOLD=3
AI_HR_PROVIDER_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# ------------------------------------------------------------
# 数据保留策略
# ------------------------------------------------------------
AI_HR_AI_INTERVIEW_TRANSCRIPT_RETENTION_DAYS=180
AI_HR_AI_INTERVIEW_AUDIO_RETENTION_DAYS=30
AI_HR_AI_INTERVIEW_EVENT_RETENTION_DAYS=365
AI_HR_AI_INTERVIEW_CLEANUP_BATCH_SIZE=500
