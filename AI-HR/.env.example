AI_HR_ENV=dev
AI_HR_DEBUG=false
AI_HR_AUTO_CREATE_TABLES=false
AI_HR_CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AI_HR_CORS_ALLOW_CREDENTIALS=false
AI_HR_AI_INTERVIEW_AUTH_REQUIRED=false
AI_HR_AI_INTERVIEW_API_KEYS=
AI_HR_DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/ai_hr

# -------- LLM --------
AI_HR_LLM_PROVIDER=openai
AI_HR_LLM_MODEL=gpt-4.1-mini
AI_HR_LLM_API_KEY=
AI_HR_LLM_BASE_URL=
AI_HR_LLM_STREAMING_ENABLED=true
AI_HR_LLM_TIMEOUT_SECONDS=8
AI_HR_LLM_MAX_RETRIES=2
AI_HR_AI_INTERVIEW_LLM_ENABLED=false

# -------- RTC --------
AI_HR_RTC_PROVIDER=mock
AI_HR_RTC_DEFAULT_TRANSPORT=webrtc
AI_HR_RTC_TOKEN_TTL_SECONDS=3600
AI_HR_LIVEKIT_BASE_URL=
AI_HR_LIVEKIT_API_KEY=
AI_HR_LIVEKIT_API_SECRET=
AI_HR_LIVEKIT_CREATE_ROOM_PATH=/twirp/livekit.RoomService/CreateRoom
AI_HR_LIVEKIT_UPDATE_SUBSCRIPTIONS_PATH=/twirp/livekit.RoomService/UpdateSubscriptions
AI_HR_LIVEKIT_SEND_DATA_PATH=/twirp/livekit.RoomService/SendData
AI_HR_LIVEKIT_ROOM_PREFIX=ai-intv-
AI_HR_AI_INTERVIEW_RTC_WEBHOOK_ENABLED=false
AI_HR_LIVEKIT_WEBHOOK_SIGNATURE_REQUIRED=true
AI_HR_LIVEKIT_WEBHOOK_API_KEY=
AI_HR_LIVEKIT_WEBHOOK_ACCEPT_SKEW_SECONDS=120
AI_HR_AI_INTERVIEW_RTC_AUDIO_SUBSCRIBE_ENABLED=false
AI_HR_AI_INTERVIEW_RTC_AUDIO_SUBSCRIBE_AUTO=true
AI_HR_AI_INTERVIEW_RTC_AUDIO_TRACK_IDS=
AI_HR_AI_INTERVIEW_RTC_AUDIO_SUBSCRIBER_IDENTITY=ai-bot
AI_HR_AI_INTERVIEW_RTC_TTS_PUBLISH_ENABLED=false
AI_HR_AI_INTERVIEW_RTC_TTS_BOT_IDENTITY=ai-bot
AI_HR_AI_INTERVIEW_RTC_VIDEO_POLICY_ENABLED=false
AI_HR_AI_INTERVIEW_RTC_VIDEO_SUBSCRIBE_AUTO=true
AI_HR_AI_INTERVIEW_RTC_VIDEO_RECORD_ENABLED=false
AI_HR_AI_INTERVIEW_RTC_VIDEO_TRACK_IDS=
AI_HR_AI_INTERVIEW_RTC_VIDEO_SUBSCRIBER_IDENTITY=ai-bot
AI_HR_AI_INTERVIEW_RTC_DUPLEX_WS_ENABLED=true
AI_HR_AI_INTERVIEW_RTC_ASR_INGEST_WS_ENABLED=true

# -------- ASR / TTS --------
AI_HR_ASR_PROVIDER=mock
AI_HR_ASR_API_KEY=
AI_HR_ASR_FORCE_STREAMING=false
AI_HR_ASR_BASE_URL=
AI_HR_ASR_STREAM_TIMEOUT_MS=5000
AI_HR_ASR_TENCENT_ENGINE_TYPE=16k_zh
AI_HR_ASR_TENCENT_VOICE_FORMAT=4
AI_HR_ASR_TENCENT_APP_ID=
AI_HR_ASR_TENCENT_WS_BASE_URL=wss://asr.cloud.tencent.com/asr/v2
AI_HR_ASR_TENCENT_STREAMING_ENABLED=true
AI_HR_ASR_TENCENT_WS_ALLOW_HTTP_FALLBACK=true
AI_HR_ASR_TENCENT_WS_EXPIRE_SECONDS=90
AI_HR_ASR_TENCENT_WS_SESSION_TTL_SECONDS=45
AI_HR_ASR_TENCENT_WS_OPEN_TIMEOUT_MS=800
AI_HR_ASR_TENCENT_PREWARM_ENABLED=true
AI_HR_ASR_TENCENT_KEEPALIVE_INTERVAL_SECONDS=8
AI_HR_ASR_TENCENT_KEEPALIVE_PCM_MS=40
AI_HR_TTS_PROVIDER=mock
AI_HR_TTS_FORCE_STREAMING=true
AI_HR_TTS_API_KEY=
AI_HR_TTS_BASE_URL=
AI_HR_TTS_STREAM_TIMEOUT_MS=5000
AI_HR_TTS_TENCENT_VOICE_TYPE=101001
AI_HR_TTS_TENCENT_SAMPLE_RATE=16000
AI_HR_TTS_TENCENT_CODEC=mp3
AI_HR_TTS_FIRST_CHUNK_SIZE=12
AI_HR_TTS_WARMUP_ENABLED=true
AI_HR_LLM_FOLLOWUP_CACHE_TTL_SECONDS=180

# -------- AI Interview Redis Runtime --------
AI_HR_REDIS_URL=redis://127.0.0.1:6379/0
AI_HR_AI_INTERVIEW_REDIS_ENABLED=false
AI_HR_AI_INTERVIEW_REDIS_PREFIX=aihr
AI_HR_AI_INTERVIEW_QUESTION_PACK_TTL_SECONDS=172800
AI_HR_AI_INTERVIEW_STATE_TTL_SECONDS=172800
AI_HR_AI_INTERVIEW_DEDUP_TTL_SECONDS=86400
AI_HR_AI_INTERVIEW_FOLLOWUP_CACHE_TTL_SECONDS=180
AI_HR_AI_INTERVIEW_PREBUILD_PACK_TTL_SECONDS=604800
AI_HR_AI_INTERVIEW_REDIS_EVENT_BUS_ENABLED=false

AI_HR_TENCENT_SECRET_ID=
AI_HR_TENCENT_SECRET_KEY=
AI_HR_TENCENT_REGION=ap-guangzhou
AI_HR_AI_INTERVIEW_TRANSCRIPT_RETENTION_DAYS=180
AI_HR_AI_INTERVIEW_AUDIO_RETENTION_DAYS=30
AI_HR_AI_INTERVIEW_EVENT_RETENTION_DAYS=365
AI_HR_AI_INTERVIEW_CLEANUP_BATCH_SIZE=500

# -------- Provider Governance --------
AI_HR_PROVIDER_HEALTH_PROBE_ENABLED=false
AI_HR_PROVIDER_HEALTH_PROBE_TIMEOUT_MS=1200
AI_HR_PROVIDER_CIRCUIT_BREAKER_FAIL_THRESHOLD=3
AI_HR_PROVIDER_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
