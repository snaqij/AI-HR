# AI-HR user configuration template
# Only keep values that users need to provide.
# Copy to `infra/env/.env.system` (or split sensitive values into `.env.secrets`).

# ===== Required: Database =====
# MySQL: https://dev.mysql.com/doc/
AI_HR_DATABASE_URL=mysql+pymysql://root:REPLACE_ME@127.0.0.1:3306/ai_hr

# ===== Required: LLM =====
# Typical providers: openai / deepseek / mock
# OpenAI API keys: https://platform.openai.com/api-keys
# OpenAI API docs: https://platform.openai.com/docs
# DeepSeek platform: https://platform.deepseek.com/
AI_HR_LLM_PROVIDER=openai
AI_HR_LLM_MODEL=gpt-4o-mini
AI_HR_LLM_BASE_URL=https://api.openai.com/v1
AI_HR_LLM_API_KEY=REPLACE_ME

# ===== Required when running AI interview with RTC =====
# Agora console (App ID / App Certificate): https://console.agora.io/
# Agora docs: https://docs.agora.io/
AI_HR_RTC_PROVIDER=agora
AI_HR_AGORA_APP_ID=REPLACE_ME
AI_HR_AGORA_APP_CERTIFICATE=REPLACE_ME

# ===== Required for ASR/TTS providers (choose by provider) =====
# ASR/TTS provider: mock / aliyun_nls / tencent
# Aliyun speech docs: https://help.aliyun.com/zh/isi/
# Aliyun access key management: https://ram.console.aliyun.com/manage/ak
# Tencent ASR docs: https://cloud.tencent.com/document/product/1093
# Tencent TTS docs: https://cloud.tencent.com/document/product/1073
# Tencent API key management: https://console.cloud.tencent.com/cam/capi
AI_HR_ASR_PROVIDER=mock
AI_HR_TTS_PROVIDER=mock

# Aliyun ASR (required when AI_HR_ASR_PROVIDER=aliyun_nls)
AI_HR_ASR_ALIYUN_APPKEY=REPLACE_ME
AI_HR_ALIYUN_ACCESS_KEY_ID=REPLACE_ME
AI_HR_ALIYUN_ACCESS_KEY_SECRET=REPLACE_ME

# Tencent ASR/TTS (required when provider uses tencent)
AI_HR_TENCENT_SECRET_ID=REPLACE_ME
AI_HR_TENCENT_SECRET_KEY=REPLACE_ME
AI_HR_ASR_TENCENT_APP_ID=REPLACE_ME
AI_HR_TTS_TENCENT_APP_ID=REPLACE_ME

# ===== Required when storing resume attachments =====
# MinIO docs: https://min.io/docs/minio/linux/index.html
# AWS S3 docs: https://docs.aws.amazon.com/s3/
AI_HR_OBJECT_STORAGE_ENABLED=true
AI_HR_OBJECT_STORAGE_PROVIDER=minio
AI_HR_OBJECT_STORAGE_ENDPOINT=127.0.0.1:9000
AI_HR_OBJECT_STORAGE_BUCKET=ai-hr
AI_HR_OBJECT_STORAGE_ACCESS_KEY=REPLACE_ME
AI_HR_OBJECT_STORAGE_SECRET_KEY=REPLACE_ME
AI_HR_OBJECT_STORAGE_SECURE=false

# ===== Optional: Email invitation =====
# SMTP provider setup examples:
# QQ Mail SMTP: https://service.mail.qq.com/detail/0/75
# 126 Mail SMTP: https://help.mail.126.com/faqDetail.do?code=d7a5dc8471d3ee8b
AI_HR_EMAIL_SMTP_HOST=smtp.example.com
AI_HR_EMAIL_SMTP_PORT=465
AI_HR_EMAIL_SMTP_USE_TLS=false
AI_HR_EMAIL_SMTP_USE_SSL=true
AI_HR_EMAIL_SMTP_USERNAME=REPLACE_ME
AI_HR_EMAIL_SMTP_PASSWORD=REPLACE_ME
AI_HR_EMAIL_FROM_ADDRESS=no-reply@example.com
AI_HR_EMAIL_FROM_NAME=AI HR

# ===== Optional: AI interview API auth =====
# Comma separated; leave empty to disable API key auth.
AI_HR_AI_INTERVIEW_API_KEYS=
AI_HR_AI_INTERVIEW_AUTH_REQUIRED=false

# ===== Optional: Encryption key =====
# Needed if your deployment uses encrypted local secrets.
AI_HR_ENCRYPTION_KEY=REPLACE_ME_BASE64_32BYTES

# ===== Optional: Boss integration =====
AI_HR_BOSS_ACCOUNT=demo-account
AI_HR_BOSS_SECRET=REPLACE_ME
AI_HR_BOSS_COOKIE_HEADER=REPLACE_ME
